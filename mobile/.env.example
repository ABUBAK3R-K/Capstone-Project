# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard -> Settings -> API. The anon key is safe to ship: RLS is what
# protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Recommendation service (FastAPI) ────────────────────────────────────────
# Powers the "Similar places" row. Leave blank to disable that section cleanly.
# Physical device: use your machine's LAN IP, not localhost.
# Android emulator: http://10.0.2.2:8000
# iOS simulator:    http://127.0.0.1:8000
EXPO_PUBLIC_RECOMMENDATIONS_URL=http://10.0.2.2:8000

# ─── Map tiles ───────────────────────────────────────────────────────────────
# IMPORTANT: do NOT point this at https://tile.openstreetmap.org/... —
# react-native-maps blocks OSM's own tile servers on Android, so tiles will
# silently fail to load there. Use a hosted OSM-style raster source instead.
#
# Mapbox (free tier, recommended):
#   https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/512/{z}/{x}/{y}@2x?access_token=YOUR_TOKEN
# MapTiler:
#   https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# Stadia Maps (requires a registered domain/bundle id):
#   https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}@2x.png?api_key=YOUR_KEY
#
# Leave blank to run the app without a basemap (markers still render).
EXPO_PUBLIC_MAP_TILE_URL=
EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors © Mapbox

# ─── Dev only ────────────────────────────────────────────────────────────────
# Skip the login screen. Reporting stays disabled, since inserts require a
# real auth.uid() under RLS.
EXPO_PUBLIC_DEV_SKIP_AUTH=false

# Tile edge length in px: 512 for Mapbox @2x styles, 256 for most others.
EXPO_PUBLIC_MAP_TILE_SIZE=512
