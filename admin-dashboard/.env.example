# Direct PostgreSQL connection string (Transaction mode recommended for Supabase pooler)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase project credentials (for Auth login flow)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service-role key — used ONLY by pages/1_Verify_Businesses.py to generate
# signed URLs for the private `business-verification` Storage bucket.
# Never expose this outside this server-side dashboard process. Optional:
# without it, the verify-businesses page still works but can't preview
# uploaded documents inline.
SUPABASE_SERVICE_ROLE_KEY=

# Dev only: set to true to bypass the Supabase login screen
SKIP_AUTH=false
