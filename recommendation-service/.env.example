# Port for FastAPI to run on locally (default 8000)
PORT=8000

# ─── Supabase Postgres connection ────────────────────────────────────────────
# Use the SESSION POOLER host, not the legacy direct host.
#
#   Session pooler:  aws-0-<region>.pooler.supabase.com:5432
#                    username is  postgres.<project-ref>
#   Direct host:     db.<project-ref>.supabase.co:5432
#                    NO LONGER RESOLVES for newer projects — psycopg2 fails with
#                    "could not translate host name ... Name or service not known",
#                    the lifespan hook swallows it, and every /recommendations
#                    request then returns 404 from an empty cache.
#
# PERCENT-ENCODE the password. Supabase generates passwords containing ? # % * @,
# and an unencoded ? or # silently truncates the URL for any standard parser
# (urlsplit reads the host as "postgres"). Encode it with:
#   python -c "from urllib.parse import quote; print(quote(input(), safe=''))"
#
# Find these under Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Same connection, as individual params (handy for scripts that build their own URL).
DB_HOST=aws-0-[REGION].pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.[PROJECT-REF]
DB_PASSWORD=your_supabase_db_password

# ─── Write-endpoint authentication (security.py) ─────────────────────────────
# POST /interactions verifies the caller's Supabase access token against
# Supabase Auth, so it needs the project URL and the public anon key — the same
# two values as mobile/.env's EXPO_PUBLIC_SUPABASE_URL / _ANON_KEY. Without
# them the endpoint returns 503 rather than accepting unverified writes.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=

# Shared secret for POST /recommendations/refresh, sent as the X-Admin-Key
# header. Leave blank to disable HTTP-triggered refreshes (the cache is still
# built at startup). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Rebuild the similarity cache in the background every N minutes, so new
# community places and newly approved businesses get "Similar places" without
# a manual refresh. 0 disables it (the cache is then only built at startup and
# on POST /recommendations/refresh).
REFRESH_INTERVAL_MINUTES=30

# Note: every line in this file must be KEY=VALUE or a # comment.
# A stray free-text line makes python-dotenv skip it with
# "could not parse statement starting at line N".
